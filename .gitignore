# Default deny: only reviewable source/documentation paths may be added normally.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/pyproject.toml
!/requirements-optional.txt
!/src/
!/src/**
!/tests/
!/tests/**
!/examples/
!/examples/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml

# Private and generated material stays ignored even in allowlisted directories.
**/private*
**/exports/
**/.env*
**/keys*.json
**/*secret*
**/*credential*
**/*account*.json
**/*.db
**/*.db-*
**/*.sqlite*
**/*.wal
**/*.shm
**/*.dylib
**/*.so
**/*.app/
**/*.disabled/
**/*.log
**/*.jsonl
**/*.txt
!/requirements-optional.txt
**/*.html
**/*.json
!/examples/config.example.json
!/examples/setup.example.json
**/*.plist
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.mp4
**/*.wav
**/*.silk
**/*.zip
**/*.tar*
**/*.pem
**/*.key
**/*.p12
**/.DS_Store
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.coverage*
**/*.py[cod]
**/.venv*/
**/*.egg-info/
**/build/
**/dist/
